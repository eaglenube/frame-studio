<header class="app-header">
  <div class="container d-flex align-items-center justify-content-between">
    <a href="/" class="brand">
      <span class="brand-mark">
        <i class="bi bi-film"></i>
      </span>
      <span class="brand-name">Frame Studio</span>
    </a>
    <nav class="app-nav d-flex align-items-center gap-2">
      <a href="/" class="nav-link nav-tab d-none d-md-inline-flex">
        <i class="bi bi-film"></i>
        <span>Frames</span>
      </a>
      <a href="/transcript" class="nav-link nav-tab d-none d-md-inline-flex">
        <i class="bi bi-mic"></i>
        <span>Transcript</span>
      </a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="user-chip dropdown">
          <button class="user-chip-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <% if (currentUser.picture) { %>
              <img src="<%= currentUser.picture %>" alt="" referrerpolicy="no-referrer" />
            <% } else { %>
              <span class="user-chip-initial"><%= (currentUser.name || currentUser.email || '?').charAt(0).toUpperCase() %></span>
            <% } %>
            <span class="user-chip-name d-none d-sm-inline"><%= currentUser.name || currentUser.email %></span>
            <i class="bi bi-chevron-down ms-1"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow user-menu">
            <li class="px-3 py-2">
              <div class="user-menu-name"><%= currentUser.name || 'Account' %></div>
              <div class="user-menu-email"><%= currentUser.email %></div>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
              <a class="dropdown-item" href="/logout">
                <i class="bi bi-box-arrow-right me-2"></i> Sign out
              </a>
            </li>
          </ul>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-outline-primary btn-pill btn-sm">
          <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
        </a>
      <% } %>
    </nav>
  </div>
</header>
