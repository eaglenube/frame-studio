<section class="page-header gallery-header">
  <div>
    <a href="/" class="back-link"><i class="bi bi-chevron-left"></i> New extraction</a>
    <h1 class="page-title">Extracted frames</h1>
    <p class="page-sub">
      <strong><%= job.totalImages %></strong> frame<%= job.totalImages === 1 ? '' : 's' %>
      from <strong><%= job.originalFilename %></strong>
    </p>
  </div>
</section>

<div class="gallery-toolbar sticky-top" data-job-id="<%= job.id %>" data-total="<%= job.totalImages %>">
  <div class="toolbar-left">
    <button type="button" class="btn btn-outline-secondary btn-sm btn-pill" id="toggleAllBtn">
      <i class="bi bi-check2-square me-1"></i> Select all on page
    </button>
    <span class="selection-counter">
      Selected <strong id="selectedCount">0</strong> / <span id="totalCount"><%= job.totalImages %></span>
    </span>
  </div>
  <div class="toolbar-right">
    <button type="button" class="btn btn-drive btn-pill" id="saveDriveBtn" disabled>
      <svg width="16" height="16" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path fill="#0066da" d="M6.6 66.85l3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3L27.5 53H0c0 1.55.4 3.1 1.2 4.5z"/>
        <path fill="#00ac47" d="M43.65 25L29.9 1.2c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44A9.06 9.06 0 000 53h27.5z"/>
        <path fill="#ea4335" d="M73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5H59.8l5.85 11.5z"/>
        <path fill="#00832d" d="M43.65 25L57.4 1.2A8.84 8.84 0 0052.9 0H34.4c-1.55 0-3.1.45-4.5 1.2z"/>
        <path fill="#2684fc" d="M59.8 53H27.5L13.75 76.8c1.4.8 2.95 1.2 4.5 1.2h50.8c1.55 0 3.1-.45 4.5-1.2z"/>
        <path fill="#ffba00" d="M73.4 26.5l-12.7-22a9.06 9.06 0 00-3.3-3.3L43.65 25 59.8 53h27.45c0-1.55-.4-3.1-1.2-4.5z"/>
      </svg>
      <span class="ms-1">Save to Drive</span>
    </button>
    <button type="button" class="btn btn-primary btn-pill" id="downloadBtn" disabled>
      <i class="bi bi-download me-1"></i>
      <span>Download selected (ZIP)</span>
    </button>
  </div>
</div>

<div id="gallery" class="gallery-grid"></div>

<div class="gallery-loadmore">
  <button type="button" class="btn btn-outline-primary btn-pill" id="loadMoreBtn">
    <span class="btn-label">Load more</span>
    <i class="bi bi-arrow-down-circle ms-1"></i>
  </button>
  <div id="galleryStatus" class="text-muted small mt-2"></div>
</div>

<div class="lightbox" id="lightbox" hidden aria-hidden="true" role="dialog" aria-label="Frame preview">
  <button type="button" class="lightbox-close" id="lightboxClose" aria-label="Close preview">
    <i class="bi bi-x-lg"></i>
  </button>

  <button type="button" class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous frame">
    <i class="bi bi-chevron-left"></i>
  </button>

  <div class="lightbox-stage" id="lightboxStage">
    <img id="lightboxImg" alt="" />
    <div class="lightbox-loading" id="lightboxLoading"><span class="spinner-inline"></span> Loading…</div>
  </div>

  <button type="button" class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next frame">
    <i class="bi bi-chevron-right"></i>
  </button>

  <div class="lightbox-bar">
    <div class="lightbox-info">
      <div class="lightbox-frame-no">Frame <span id="lbFrame">—</span></div>
      <div class="lightbox-meta">
        <span id="lbTimestamp">—</span>
        <span class="dot-sep">·</span>
        <span id="lbPosition">—</span>
      </div>
    </div>
    <div class="lightbox-actions">
      <button type="button" class="btn btn-outline-light btn-pill btn-sm" id="lightboxToggleSelect">
        <i class="bi bi-check2-square me-1"></i> <span id="lbSelectLabel">Select</span>
      </button>
      <button type="button" class="btn btn-outline-light btn-pill btn-sm" id="lightboxDriveBtn">
        <i class="bi bi-cloud-arrow-up me-1"></i> Save to Drive
      </button>
      <a class="btn btn-primary btn-pill btn-sm" id="lightboxDownload" href="#" download>
        <i class="bi bi-download me-1"></i> Download
      </a>
    </div>
  </div>
</div>

<!-- Custom folder picker modal -->
<div class="modal fade folder-modal" id="folderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title">
            <svg width="18" height="18" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="vertical-align:-3px;margin-right:6px;">
              <path fill="#0066da" d="M6.6 66.85l3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3L27.5 53H0c0 1.55.4 3.1 1.2 4.5z"/>
              <path fill="#00ac47" d="M43.65 25L29.9 1.2c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44A9.06 9.06 0 000 53h27.5z"/>
              <path fill="#ea4335" d="M73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5H59.8l5.85 11.5z"/>
              <path fill="#00832d" d="M43.65 25L57.4 1.2A8.84 8.84 0 0052.9 0H34.4c-1.55 0-3.1.45-4.5 1.2z"/>
              <path fill="#2684fc" d="M59.8 53H27.5L13.75 76.8c1.4.8 2.95 1.2 4.5 1.2h50.8c1.55 0 3.1-.45 4.5-1.2z"/>
              <path fill="#ffba00" d="M73.4 26.5l-12.7-22a9.06 9.06 0 00-3.3-3.3L43.65 25 59.8 53h27.45c0-1.55-.4-3.1-1.2-4.5z"/>
            </svg>
            Save to Google Drive
          </h5>
          <div class="modal-sub" id="folderModalSub">Choose a folder, or create a new one.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <nav class="folder-breadcrumbs" id="folderBreadcrumbs" aria-label="Breadcrumb"></nav>

        <div class="folder-list-wrap">
          <div class="folder-list" id="folderList"></div>
          <div class="folder-empty" id="folderEmpty" hidden>
            <i class="bi bi-folder2-open"></i>
            <div>No subfolders here.</div>
            <small>Create a new one below, or click <em>Save here</em>.</small>
          </div>
          <div class="folder-loading" id="folderLoading">
            <span class="spinner-inline"></span> Loading folders…
          </div>
          <div class="folder-error" id="folderError" hidden></div>
        </div>

        <div class="folder-new">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-folder-plus"></i></span>
            <input type="text" class="form-control" id="newFolderName" placeholder="New folder name…" maxlength="200" />
            <button type="button" class="btn btn-outline-primary" id="createFolderBtn">Create folder</button>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <div class="folder-selected" id="folderSelected">
          Selected: <strong id="folderSelectedName">My Drive</strong>
        </div>
        <div class="folder-actions-right">
          <button type="button" class="btn btn-outline-secondary btn-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary btn-pill" id="saveHereBtn">
            <i class="bi bi-cloud-arrow-up me-1"></i> Save here
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>window.__IS_LOGGED_IN__ = <%= currentUser ? 'true' : 'false' %>;</script>
<script src="/js/drive.js"></script>
<script src="/js/gallery.js"></script>
