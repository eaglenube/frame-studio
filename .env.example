PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
SESSION_SECRET=
MAX_UPLOAD_MB=500

# Public app URL (used to build OAuth callback)
APP_URL=http://localhost:3000

# Google OAuth (Web application client) -- see README for setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=

# Anthropic Claude (optional, only needed for the "AI summary" option in the
# transcript flow). Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Transcription models. We auto-pick by language:
#   - WHISPER_MODEL_EN is used when the job's language is English (fast,
#     English-only, small download).
#   - WHISPER_MODEL_MULTILINGUAL is used for every other language. The
#     smaller multilingual models (tiny, base) are noticeably poor on
#     non-Latin-script languages like Hindi/Arabic/Chinese, so we default
#     to large-v3-turbo (~1.6 GB, one-time download) which is also the
#     fastest of the high-quality models.
# Choices: tiny, tiny.en, base, base.en, small, small.en, medium,
#          medium.en, large-v3-turbo, large.
# Models are auto-downloaded into ./.whisper-models on first use.
WHISPER_MODEL_EN=base.en
WHISPER_MODEL_MULTILINGUAL=large-v3-turbo

# Optional override if `yt-dlp` is not on PATH (needed for the "From YouTube"
# upload source on the frames page).
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
